# Discord bot token (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# Cohere API keys — either a comma-separated list...
COHERE_API_KEYS=
# ...or numbered keys (both styles work, all keys found are used in rotation)
# COHERE_API_KEY_1=
# COHERE_API_KEY_2=

# Optional overrides
# COHERE_MODEL=command-a-03-2025
# CHAT_HISTORY_LIMIT=30
# PORT=8080
