# Discord bot token (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# --- AI chat providers -------------------------------------------------------
# Configure one or both. With both, the bot uses the primary and automatically
# falls back to the other. Any number of keys per provider — the bot
# round-robins through all of them.

# Gemini (free tier: get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEYS=
# or: GEMINI_API_KEY= / GEMINI_API_KEY_1= / GEMINI_API_KEY_2= ...

# Cohere (free trial keys: https://dashboard.cohere.com/api-keys)
COHERE_API_KEYS=
# or: COHERE_API_KEY_1= / COHERE_API_KEY_2= ...

# Claude for YOU only: your own messages are answered through your local
# claude-api server (https://github.com/Xiao215/claude-api) on your Pro/Max
# subscription, with the same tools and image support. Everyone else keeps
# using Gemini/Cohere; never point other users at your subscription. If the
# server isn't running, you fall back to Gemini/Cohere too.
# The owner defaults to whoever owns the bot in the Developer Portal; override
# with a Discord user id (Developer Mode -> right-click user -> Copy User ID).
# OWNER_ID=
# CLAUDE_API_URL=http://127.0.0.1:8787   # empty = owner-only Claude off
# CLAUDE_API_KEY=                        # only if claude-api has API_KEY set
# CLAUDE_MODEL=sonnet                    # haiku | sonnet | opus; empty = server default

# Optional overrides
# CHAT_PROVIDER=auto            # auto (prefers gemini) | gemini | cohere
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_LIST_PRO=1             # show Gemini Pro in /models (needs billing; free tier is 0)
# COHERE_MODEL=command-a-plus-05-2026
# CHAT_HISTORY_LIMIT=30          # how far back the AI may read (per-channel: /context)
# CHAT_BASE_CONTEXT=8           # messages shown up front; it fetches more itself
# CHAT_MAX_TOOL_ROUNDS=4
# CHAT_TIMEOUT=90               # seconds a model gets before failing over
# CHAT_MAX_IMAGES=4             # images per message the AI looks at
# CHAT_IMAGE_MAX_MB=5
# CHAT_MAX_PDFS=2               # PDFs per message (read by Gemini/Claude, not Cohere)
# CHAT_PDF_MAX_MB=10
# CHAT_MAX_TEXT_FILES=3         # .txt/.md/.csv/code files pasted into the prompt
# CHAT_TEXT_MAX_CHARS=20000     # per text file; longer ones are cut off
# PORT=8080

# Papers digest schedule (optional)
# PAPERS_HOUR=9
# TIMEZONE=America/Toronto
