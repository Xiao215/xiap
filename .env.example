# Discord bot token (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# --- AI chat providers -------------------------------------------------------
# Configure cli-bridge, Cohere or both. With both, the bot uses the primary and
# automatically falls back to the others.

# Claude and Gemini: everyone can select models served by your cli-bridge
# server (https://github.com/Xiao215/cli-bridge), with the same tools and
# image/PDF support. Gemini models show up when agy (the Antigravity CLI) is
# set up next to it. If unavailable, the bot falls back to another provider.
# CLI_BRIDGE_URL=http://127.0.0.1:8787   # empty = off
# CLI_BRIDGE_KEY=                        # only if cli-bridge has API_KEY set
# CLI_BRIDGE_TIMEOUT=300                 # seconds per request; the CLIs can be slow
# CLAUDE_MODEL=sonnet                    # haiku | sonnet | opus; empty = server default
# GEMINI_MODEL=gemini-3.8-flash-high     # see /models; empty = agy picks

# Cohere (free trial keys: https://dashboard.cohere.com/api-keys). Any number
# of keys — the bot round-robins through all of them.
COHERE_API_KEYS=
# or: COHERE_API_KEY_1= / COHERE_API_KEY_2= ...

# Optional overrides
# CHAT_PROVIDER=auto            # auto (claude, gemini, cohere) | claude | gemini | cohere
# COHERE_MODEL=command-a-plus-05-2026
# CHAT_HISTORY_LIMIT=30          # how far back the AI may read (per-channel: /context)
# CHAT_BASE_CONTEXT=8           # messages shown up front; it fetches more itself
# CHAT_MAX_TOOL_ROUNDS=4
# CHAT_TIMEOUT=90               # seconds a Cohere model gets before failing over
# CHAT_MAX_IMAGES=4             # images per ping the AI looks at (incl. recent messages)
# CHAT_IMAGE_MAX_MB=5
# CHAT_MAX_PDFS=2               # PDFs per message (read by Claude/Gemini, not Cohere)
# CHAT_PDF_MAX_MB=10
# CHAT_MAX_TEXT_FILES=3         # .txt/.md/.csv/code files pasted into the prompt
# CHAT_TEXT_MAX_CHARS=20000     # per text file; longer ones are cut off
# PORT=8080

# Papers digest schedule (optional)
# PAPERS_HOUR=9
# TIMEZONE=America/Toronto
